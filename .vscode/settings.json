{
  "files.autoSave": "afterDelay",
  "editor.wordWrap": "on",
  "window.zoomLevel": -0.6,

  "editor.fontFamily": "JetBrains Mono, Cascadia Code, Fira Code, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12.75,
  "editor.fontWeight": "400",
  "editor.lineHeight": 18,
  "editor.letterSpacing": 0.3,

  "terminal.integrated.fontFamily": "monospace",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  "editor.tabSize": 3,
  "editor.renderWhitespace": "selection",
  "editor.minimap.enabled": true,
  "editor.minimap.scale": 1,
  "editor.minimap.size": "fit",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.guides.indentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",

  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.turbo/**": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true
  },

  "files.exclude": {
    "**/.DS_Store": false,
    "**/.git": false,
    "**/.hg": false,
    "**/.svn": false,
    "**/Thumbs.db": false
  },

  "workbench.startupEditor": "none",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.png": "imagePreview.previewEditor",
    "*.db": "default"
  },

  "workbench.preferredDarkColorTheme": "Cursor Dark High Contrast",
  "workbench.iconTheme": "vira-icons-carbon",
  "workbench.productIconTheme": "viraUIIcons",
  "material-icon-theme.folders.theme": "specific",

  "git.openRepositoryInParentFolders": "never",
  "git.enableSmartCommit": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  "breadcrumbs.enabled": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "console-ninja.featureSet": "Community",

  "window.autoDetectColorScheme": true
}
